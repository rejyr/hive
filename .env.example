# Copy to .env and fill in. Never commit .env.
PORT=3000
HIVE_TOKEN=change-me-team-secret
HIVE_DB_PATH=./hive.db

# The Queen (optional — everything but synthesis works without these)
QUEEN_BASE_URL=https://inference.runanywhere.ai/v1
QUEEN_API_KEY=
QUEEN_MODEL=glm-5.3-flash

# Deploy (scripts/deploy.js)
FREESTYLE_API_KEY=
HIVE_DOMAIN=hive.style.dev
